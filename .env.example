# Supabase > Project Settings > API: project URL and publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon key is also supported; never use service_role or a secret key here.
VITE_SUPABASE_ANON_KEY=
# Optional: public Turnstile site key; configure its secret in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=
VITE_WHATSAPP_GROUP_URL=
